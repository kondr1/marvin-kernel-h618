/*
 * Copyright (c) 2025 Patrick Yavitz <pyavitz@armbian.com>
 *
 * Изменено для Marvin: убраны узлы, которых нет в mainline 6.18 (аудиохаб,
 * дисплей с HDMI, второй Ethernet) и отключённая периферия, ссылавшаяся на
 * pinctrl-определения из патч-сета Armbian (i2c1/3/4, uart1/4/5, spi0/1, ir).
 * Оригинал собирается только поверх патчей Armbian; здесь нужен файл,
 * собирающийся на mainline.
 */

/dts-v1/;

#include "sun50i-h616.dtsi"
#include "sun50i-h616-cpu-opp.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/leds/common.h>

/ {
	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reg_usb_vbus: regulator-usb-vbus {
		/* Отдельный регулятор на USB-порты */
		compatible = "regulator-fixed";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-name = "usb-vbus";
		vin-supply = <&reg_vcc5v>;
	};

	reg_vcc5v: regulator-vcc5v {
		/* 5 В с разъёма USB-C на всю плату */
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-name = "vcc-5v";
	};

	reg_vcc3v3: regulator-vcc3v3 {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-name = "vcc-3v3";
		vin-supply = <&reg_vcc5v>;
	};

	reg_vcc1v8: regulator-vcc1v8 {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-name = "vcc-1v8";
		vin-supply = <&reg_vcc3v3>;
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rtc CLK_OSC32K_FANOUT>;
		clock-names = "ext_clock";
		pinctrl-0 = <&x32clk_fanout_pin>;
		pinctrl-names = "default";
		post-power-on-delay-ms = <200>;
		reset-gpios = <&pio 6 18 GPIO_ACTIVE_LOW>; /* PG18 */
	};
};

&cpu0 {
	cpu-supply = <&reg_dcdc2>;
};

/* SD-карта: с неё идёт первичная загрузка при bring-up. */
&mmc0 {
	status = "okay";
	bus-width = <4>;
	max-frequency = <50000000>;

	disable-wp;

	cd-gpios = <&pio 5 6 GPIO_ACTIVE_HIGH>;	/* PF6 */
	vmmc-supply = <&reg_vcc3v3>;
};

/* eMMC */
&mmc2 {
	status = "okay";
	bus-width = <8>;
	cap-mmc-hw-reset;
	mmc-hs200-1_8v;

	non-removable;
	disable-wp;

	vmmc-supply = <&reg_vcc3v3>;
	vqmmc-supply = <&reg_vcc1v8>;
};

&pio {
	vcc-pc-supply = <&reg_aldo1>;
	vcc-pf-supply = <&reg_dldo1>;
	vcc-pg-supply = <&reg_dldo1>;
	vcc-ph-supply = <&reg_dldo1>;
	vcc-pi-supply = <&reg_dldo1>;

	mmc2_pins: mmc2-pins {
		pins = "PC1", "PC5", "PC6",
		       "PC8", "PC9", "PC10", "PC11",
		       "PC13", "PC14", "PC15", "PC16";
		function = "mmc2";
		drive-strength = <30>;
		bias-pull-up;
	};
};

/* PMIC: задаёт напряжения CPU, DRAM и линий ввода-вывода. Без него плата
 * не поднимется — это не опциональная периферия. */
&r_i2c {
	status = "okay";
	axp313: pmic@36 {
		compatible = "x-powers,axp313a";
		reg = <0x36>;
		#interrupt-cells = <1>;
		interrupt-controller;
		interrupt-parent = <&pio>;

		vin1-supply = <&reg_vcc5v>;
		vin2-supply = <&reg_vcc5v>;
		vin3-supply = <&reg_vcc5v>;

		regulators {
			reg_aldo1: aldo1 {
				regulator-always-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc-1v8-pll";
			};

			reg_dldo1: dldo1 {
				regulator-always-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc-3v3-io";
			};

			reg_dcdc1: dcdc1 {
				regulator-always-on;
				regulator-min-microvolt = <810000>;
				regulator-max-microvolt = <990000>;
				regulator-name = "vdd-gpu-sys";
			};

			reg_dcdc2: dcdc2 {
				regulator-always-on;
				regulator-min-microvolt = <810000>;
				regulator-max-microvolt = <1100000>;
				regulator-name = "vdd-cpu";
			};

			reg_dcdc3: dcdc3 {
				regulator-always-on;
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
				regulator-name = "vdd-dram";
			};
		};
	};
};

/* Консоль bring-up. Скорость зафиксирована в chosen/stdout-path. */
&uart0 {
	status = "okay";
	pinctrl-0 = <&uart0_ph_pins>;
	pinctrl-names = "default";
};
