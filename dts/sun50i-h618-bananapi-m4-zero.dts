/*
 * Copyright (c) 2025 Patrick Yavitz <pyavitz@armbian.com>
 *
 * Modified for Marvin: dropped the aliases for removed peripherals, the AC300
 * clocking via pwm (not in mainline) and the internal Ethernet PHY
 * calibration — our configuration has no wired port.
 */

/dts-v1/;

#include "sun50i-h618-bananapi-m4.dtsi"

/ {
	model = "BananaPi BPI-M4-Zero";
	compatible = "sinovoip,bpi-m4-zero", "allwinner,sun50i-h618";

	leds {
		compatible = "gpio-leds";

		led-0 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&pio 2 12 GPIO_ACTIVE_HIGH>;	/* PC12 */
			linux,default-trigger = "heartbeat";
		};
	};
};

/*
 * USB hosts. A comment by the original DTS author says ehci1 carries the
 * onboard RTL8821CU Wi-Fi — i.e. the built-in radio sits on USB, not on SDIO.
 * That contradicts both our documentation (AIC8800 over SDIO) and the mmc1
 * node below. To be settled by the first boot log, see docs/bring-up.md §2.
 */
&ehci1 {
	status = "okay";
};

&ehci2 {
	status = "okay";
};

&ehci3 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&ohci2 {
	status = "okay";
};

&ohci3 {
	status = "okay";
};

/*
 * SDIO: the onboard BCM43455 radio (measured on the board, revision v2 —
 * docs/hardware-inventory.md in marvin-research). Node enabled.
 *
 * compatible stays "brcm,bcm4329-fmac": that is the generic brcmfmac binding
 * for all Broadcom SDIO chips — the driver detects the actual model itself and
 * requests firmware accordingly.
 */
&mmc1 {
	status = "okay";
	bus-width = <4>;
	max-frequency = <100000000>;

	non-removable;
	disable-wp;

	/* The radio firmware requires power to be kept across suspend */
	keep-power-in-suspend;

	mmc-pwrseq = <&wifi_pwrseq>;

	cd-gpios = <&pio 6 15 GPIO_ACTIVE_HIGH>;	/* PG15 */
	vmmc-supply = <&reg_vcc3v3>;

	sdio: wifi@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";

		/*
		 * Country code translation for the firmware.
		 *
		 * The NVRAM shipped for this board sets ccode=0 — no country at
		 * all — and the firmware then reports country 99 and rejects every
		 * 5 GHz channel, measured as
		 *
		 *   brcmf_cfg80211_start_ap: Set Channel failed: chspec=53284, -52
		 *
		 * even though BCM43455 and the board are both dual-band. The band
		 * is closed by configuration, not by hardware.
		 *
		 * brcmfmac forwards a regulatory hint to the firmware only after
		 * translating the ISO code through this map. The mapping is trivial
		 * (ISO code, revision 0), which is what vendor device trees for this
		 * chip carry; extend the list as other regions are needed.
		 *
		 * Hypothesis until confirmed on hardware: with a country the firmware
		 * accepts, 5 GHz channels appear and hostapd can use them.
		 */
		brcm,ccode-map = "RU-RU-0", "US-US-0", "DE-DE-0", "GB-GB-0",
				 "FR-FR-0", "PL-PL-0", "KZ-KZ-0", "TR-TR-0";
	};
};

&usbotg {
	status = "okay";
	dr_mode = "peripheral";
};

&usbphy {
	status = "okay";
	usb1_vbus-supply = <&reg_usb_vbus>;
};
