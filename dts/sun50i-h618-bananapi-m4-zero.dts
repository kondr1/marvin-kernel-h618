 * Copyright (c) 2025 Patrick Yavitz <pyavitz@armbian.com>
 *
 * Изменено для Marvin: убраны aliases на удалённую периферию, тактирование
 * AC300 через pwm (нет в mainline) и калибровка внутреннего Ethernet-PHY —
 * проводного порта в нашей конфигурации нет.
 */

/dts-v1/;

#include "sun50i-h618-bananapi-m4.dtsi"

/ {
	model = "BananaPi BPI-M4-Zero";
	compatible = "sinovoip,bpi-m4-zero", "allwinner,sun50i-h618";

	leds {
		compatible = "gpio-leds";

		led-0 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&pio 2 12 GPIO_ACTIVE_HIGH>;	/* PC12 */
			linux,default-trigger = "heartbeat";
		};
	};
};

/*
 * USB-хосты. По комментарию автора оригинального DTS к ehci1 подключён
 * онбордовый Wi-Fi RTL8821CU — то есть встроенное радио висит на USB, а не
 * на SDIO. Это противоречит и нашим докам (AIC8800 по SDIO), и узлу mmc1
 * ниже. Разрешается логом первой загрузки, см. docs/bring-up.md §2.
 */
&ehci1 {
	status = "okay";
};

&ehci2 {
	status = "okay";
};

&ehci3 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&ohci2 {
	status = "okay";
};

&ohci3 {
	status = "okay";
};

/*
 * SDIO. Оставлен выключенным, как в оригинале: пока не подтверждено, что за
 * радио на плате, включать узел не на чем — compatible ниже унаследован от
 * родственной платы и может не соответствовать этой.
 */
&mmc1 {
	status = "disabled";
	bus-width = <4>;
	max-frequency = <100000000>;

	non-removable;
	disable-wp;

	/* Firmware радио требует питания в suspend */
	keep-power-in-suspend;

	mmc-pwrseq = <&wifi_pwrseq>;

	cd-gpios = <&pio 6 15 GPIO_ACTIVE_HIGH>;	/* PG15 */
	vmmc-supply = <&reg_vcc3v3>;

	sdio: wifi@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";
	};
};

&usbotg {
	status = "okay";
	dr_mode = "peripheral";
};

&usbphy {
	status = "okay";
	usb1_vbus-supply = <&reg_usb_vbus>;
};
