# Wi-Fi: стек и драйверы адаптеров.
#
# Конкретное радио под AP выбирает резолвер на устройстве (ADR-0017), поэтому
# в ядро включаются драйверы всех адаптеров комплекта, а не одного «нужного».
# Драйвер встроенного AIC8800 в mainline отсутствует и добавляется отдельно
# как out-of-tree — здесь его нет намеренно.
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_CRYPTO_LIB_ARC4=y

# RTL8812AU: с 6.14 драйвер in-kernel и работает в режиме AP.
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_RTW88=y
CONFIG_RTW88_USB=y
CONFIG_RTW88_8812AU=y

# RTL8188ETV: только station, AP в mainline не готов (ADR-0008).
CONFIG_RTL8XXXU=y

# SDIO нужен встроенному радио на плате.
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
