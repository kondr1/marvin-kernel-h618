# Wi-Fi: the stack and the adapter drivers.
#
# Which radio ends up serving the AP is decided by the on-device role resolver
# (ADR-0017), so the kernel carries drivers for every adapter in the kit rather
# than for one "correct" one.
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_CRYPTO_LIB_ARC4=y

# The onboard radio is a BCM43455 on SDIO (measured on the board, not assumed:
# docs/hardware-inventory.md). The driver is in-kernel; nothing out-of-tree is
# required. Built as a module rather than built-in: its firmware is loaded from
# lib/firmware once rootfs is mounted, so having the driver present earlier
# gains nothing.
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PROTO_BCDC=y
CONFIG_BRCMFMAC_SDIO=y

# Every radio driver is a module, never built-in. Each one needs firmware from
# lib/firmware, and a built-in driver probes before rootfs is mounted: the file
# is not there yet and the radio silently fails to come up. Modules are loaded
# by our own loader once rootfs is available (kernel-build.md §5).
CONFIG_USB=y
CONFIG_USB_SUPPORT=y

# The onboard radio hangs off SDIO and is powered up by mmc-pwrseq-simple,
# which toggles a reset line through GPIO. Measured on the board: with
# RESET_GPIO enabled the probe fails outright.
#
# The reason is in the reset core. When a device has reset-gpios but no resets
# property, the core hands the line to its own GPIO-backed reset controller —
# and that path supports only #gpio-cells = 2, while the sunxi pin controller
# uses three (bank, pin, flags). It answers -ENOENT, and pwrseq_simple treats
# that as fatal without ever reaching its own GPIO fallback, which works fine.
#
#   pwrseq_simple wifi-pwrseq: error -ENOENT: reset control not ready
#   pwrseq_simple wifi-pwrseq: probe with driver pwrseq_simple failed
#
# mmc1 then never initializes and the onboard Wi-Fi is simply absent. Nothing
# on this board needs a GPIO-backed reset controller, so it is turned off.
# CONFIG_RESET_GPIO is not set

# RTL8812AU (0bda:8812) — present in the rtw88 device table in 6.18, and the
# driver advertises NL80211_IFTYPE_AP. Needs firmware rtw88/rtw8812a_fw.bin.
CONFIG_RTW88=m
CONFIG_RTW88_USB=m
CONFIG_RTW88_8812AU=m

# RTL8188EU (0bda:0179) — on the board it enumerates as EU, not ETV.
# Station only, no AP. Needs firmware rtlwifi/rtl8188eufw.bin.
CONFIG_RTL8XXXU=m

# SDIO is what the board's onboard radio hangs off.
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
