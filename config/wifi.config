# Wi-Fi: стек и драйверы адаптеров.
#
# Конкретное радио под AP выбирает резолвер на устройстве (ADR-0017), поэтому
# в ядро включаются драйверы всех адаптеров комплекта, а не одного «нужного».
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_CRYPTO_LIB_ARC4=y

# Онбордовое радио — BCM43455 по SDIO (измерено на плате, а не предположено:
# docs/hardware-inventory.md). Драйвер in-kernel, out-of-tree не требуется.
# Модулем, а не built-in: firmware грузится из lib/firmware после монтирования
# rootfs, поэтому раннее присутствие драйвера смысла не имеет.
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PROTO_BCDC=y
CONFIG_BRCMFMAC_SDIO=y

# Все драйверы радио — модулями, а не built-in. Каждому нужно firmware из
# lib/firmware, а встроенный драйвер пробуется до монтирования rootfs: файла
# ещё нет, радио молча не поднимается. Модули грузятся нашим загрузчиком
# после того, как rootfs доступен (kernel-build.md §5).
CONFIG_USB=y
CONFIG_USB_SUPPORT=y

# RTL8812AU (0bda:8812) — есть в таблице rtw88 в 6.18, драйвер объявляет
# NL80211_IFTYPE_AP. Требует firmware rtw88/rtw8812a_fw.bin.
CONFIG_RTW88=m
CONFIG_RTW88_USB=m
CONFIG_RTW88_8812AU=m

# RTL8188EU (0bda:0179) — на плате определяется именно как EU, не ETV.
# Только station, AP нет. Требует firmware rtlwifi/rtl8188eufw.bin.
CONFIG_RTL8XXXU=m

# SDIO нужен встроенному радио на плате.
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
