# Требования gokrazy к ядру.
#
# Root монтируется read-only, изменяемое состояние живёт в /perm. udev нет,
# поэтому devtmpfs монтируется самим ядром. Консоль на serial обязательна:
# на этапе bring-up это единственный способ увидеть ранний boot.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y

# Загрузчик модулей ходит через finit_module(2) и читает modules.dep.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# virtio нужен для QEMU-профиля (два virtio-NIC = WAN/LAN, диск, консоль).
# Указано явно: в trim.config выключается CONFIG_VIRTUALIZATION, а это KVM
# как хост — гостевые virtio-драйверы к нему отношения не имеют, но связь
# легко перепутать при следующей правке.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
