# What gokrazy requires from the kernel.
#
# Root is mounted read-only, mutable state lives in /perm. There is no udev, so
# devtmpfs has to be mounted by the kernel itself. A serial console is
# mandatory: during bring-up it is the only way to observe early boot.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y

# The module loader goes through finit_module(2) and reads modules.dep.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# virtio is needed for the QEMU profile (two virtio NICs = WAN/LAN, disk,
# console). Spelled out explicitly because trim.config turns off
# VIRTUALIZATION, which is KVM host support — guest virtio drivers have nothing
# to do with it, but the two are easy to conflate on the next edit.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
