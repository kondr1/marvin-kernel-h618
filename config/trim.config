# Disabling subsystems the router does not have.
#
# The build starts from the arm64 defconfig, which targets a general-purpose
# distribution and enables thousands of modules. Combined with the full
# DEBUG_INFO required for BTF, every superfluous module is paid for in build
# time and image size.
#
# Only things the appliance demonstrably does not have are turned off here.
# Network, Wi-Fi, MMC/SDIO and USB drivers are left alone — they are listed in
# their own fragments.

# No sound, no display: the device is headless, the console is serial.
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_LOGO is not set

# Cameras, tuners, DVB.
# CONFIG_MEDIA_SUPPORT is not set

# RDMA/InfiniBand and virtualization as a host.
# CONFIG_INFINIBAND is not set
# CONFIG_VIRTUALIZATION is not set

# Staging drivers are by definition not product material.
# CONFIG_STAGING is not set

# Filesystems: the image uses squashfs (root), ext4 and vfat (/perm and boot),
# and tmpfs. Everything else is dead weight.
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CEPH_FS is not set
# CONFIG_CIFS is not set

# Exotic network stacks we do not use.
# CONFIG_HAMRADIO is not set
# CONFIG_CAN is not set
# CONFIG_BT is not set
