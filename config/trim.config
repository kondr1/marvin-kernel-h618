# Отключение подсистем, которых на маршрутизаторе нет.
#
# База сборки — arm64 defconfig, он рассчитан на универсальный дистрибутив и
# включает тысячи модулей. Вместе с полным DEBUG_INFO, обязательным для BTF,
# каждый лишний модуль оплачивается временем сборки и местом в образе.
#
# Здесь отключается только то, чего у appliance заведомо нет. Драйверы сети,
# Wi-Fi, MMC/SDIO и USB не трогаются — они перечислены в своих фрагментах.

# Ни звука, ни экрана: устройство безголовое, консоль на serial.
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_LOGO is not set

# Камеры, тюнеры, DVB.
# CONFIG_MEDIA_SUPPORT is not set

# RDMA/InfiniBand и виртуализация как хост.
# CONFIG_INFINIBAND is not set
# CONFIG_VIRTUALIZATION is not set

# Драйверы в staging по определению не для продукта.
# CONFIG_STAGING is not set

# Файловые системы: в образе squashfs (root), ext4 и vfat (/perm и boot),
# tmpfs. Остальное — лишние модули.
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CEPH_FS is not set
# CONFIG_CIFS is not set

# Экзотические сетевые стеки, которых у нас нет.
# CONFIG_HAMRADIO is not set
# CONFIG_CAN is not set
# CONFIG_BT is not set
