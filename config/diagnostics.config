# Being observable without a console.
#
# The debug UART header on this board is not populated, so on an unmodified
# board there is no serial console at all. What is left has to carry the whole
# diagnostic load, and none of it is optional:
#
#   - the serial gadget on the OTG port (see usb.config), which starts talking
#     only after the kernel is up;
#   - the status LED, which is the only signal that exists before that.
#
# The DTS puts a heartbeat trigger on the red status LED (PC12). A blinking LED
# means the kernel is alive and the scheduler runs; a solid or dark LED
# separates "never got to the kernel" from "kernel died later" — the one
# distinction that is otherwise unavailable without a UART.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# Panics must not hang silently: with panic=10 in bootargs the board reboots,
# and a repeating boot is itself a readable signal on the LED.
CONFIG_PANIC_TIMEOUT=10
