# eBPF, BTF and TC — without these dae does not start at all.
#
# DEBUG_INFO_BTF inflates the kernel noticeably. That is a deliberate trade:
# without BTF dae cannot load its eBPF programs, so the product does not do the
# one thing it exists for. The build container needs pahole (the dwarves
# package), otherwise no BTF is generated.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_CGROUPS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_NET_INGRESS=y
CONFIG_NET_EGRESS=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF5=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y

# BTF is needed for vmlinux, not for every module: with BTF_MODULES pahole runs
# separately over each built module, which across the full driver set adds tens
# of minutes of build time and buys dae nothing.
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
