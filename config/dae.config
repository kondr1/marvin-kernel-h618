# eBPF, BTF и TC — без этого dae не стартует вообще.
#
# DEBUG_INFO_BTF заметно раздувает ядро. Это осознанный размен: без BTF dae не
# загружает свои eBPF-программы, то есть продукт не выполняет свою функцию.
# Контейнеру сборки нужен pahole (пакет dwarves) — иначе BTF не сгенерируется.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_CGROUPS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_NET_INGRESS=y
CONFIG_NET_EGRESS=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF5=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y

# BTF нужен для vmlinux, а не для каждого модуля: с BTF_MODULES pahole
# отрабатывает по каждому собранному модулю отдельно, что на полном наборе
# драйверов даёт десятки минут сборки без всякой пользы для dae.
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
