# USB: host controllers, the PHY, and a gadget console on the OTG port.
#
# Host side. Both Wi-Fi dongles hang off ehci/ohci, so a missing controller
# here does not look like a USB problem on the board — it looks like the radios
# do not exist. These come from the arm64 defconfig today; they are spelled out
# so that a defconfig change cannot silently remove them.
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y

# The PHY serves every USB port on the SoC, host ports included.
CONFIG_PHY_SUN4I_USB=y

# OTG port as a gadget. The H616 dtsi declares usb@5100000 with
# "allwinner,sun50i-h616-musb", so the driver is musb with the sunxi glue, and
# our DTS already sets dr_mode = "peripheral" on that node.
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_DUAL_ROLE=y

# A serial gadget on the OTG port: plugged into a PC, the board appears as a
# CDC-ACM device — a COM port on Windows, /dev/ttyACM* on Linux — with no
# driver to install. This is the diagnostic channel for a machine that has no
# UART adapter, and it is built in rather than modular so that it comes up
# even if nothing in userspace ever starts.
#
# It does NOT replace the UART: enumeration happens long after the bootloader,
# so SPL, U-Boot and early kernel output are invisible here. Early boot stays
# the UART's job (bring-up.md §4).
CONFIG_USB_GADGET=y
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
