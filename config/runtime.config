# Всё, что ядро подгружает само, должно быть встроено.
#
# На gokrazy нет /sbin/modprobe. Ядро зовёт его через request_module, когда ему
# в рантайме требуется алгоритм шифрования или выражение nftables, и на нашей
# системе этот вызов просто ничего не находит. Наш загрузчик модулей тут не
# помогает: он работает по modalias устройств, а у крипто-алгоритма нет ни
# устройства, ни modalias.
#
# Отсюда правило: то, что запрашивается по имени в рантайме, собирается
# встроенным. Отказ иначе выглядит дико — точка доступа поднимается и
# отваливает клиентов на четырёхстороннем рукопожатии, а NAT молча не
# создаётся.

# Шифрование WPA2/WPA3. mac80211 запрашивает ccm(aes) при установке ключей,
# CMAC нужен для защиты management-кадров (обязательной в SAE), SHA-256 —
# для самого SAE.
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y

# nftables подгружает выражения по мере появления правил. NFT_NAT собирает и
# выражение nat, и тип цепочки nat (nft_chain_nat.o) — отдельного символа под
# цепочку в актуальном ядре нет, хотя документация по nftables о нём говорит.
# Без этого цепочку типа nat создать нельзя вовсе, то есть NAT для клиентов не
# работает, хотя masquerade в конфиге присутствует.
#
# Счётчик (nft_counter.o) вкомпилирован в сам nf_tables и отдельной опции не
# имеет.
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y

# Требования dae сверх BPF_SYSCALL: программы, цепляющиеся к kprobe и
# tracepoint, без этих опций не грузятся.
CONFIG_BPF_EVENTS=y
CONFIG_KPROBE_EVENTS=y
CONFIG_KPROBES=y

# Дисциплина очереди по умолчанию. Для маршрутизатора на слабом канале это
# разница между «интернет тормозит» и «работает».
CONFIG_NET_SCH_FQ_CODEL=y

# Виртуальное радио для QEMU-гейта: на плате не используется, но образ и для
# QEMU собирается тот же.
CONFIG_MAC80211_HWSIM=m
